NODE_ENV=development
PORT=4000
# Bind loopback only. The production topology is Internet → Nginx/Caddy →
# Next.js → this backend (co-located), so the backend never needs to be
# reachable off-host. Use 0.0.0.0 ONLY for a split-host deployment, and then
# firewall PORT from the public internet. See DEPLOYMENT.md. A non-loopback
# HOST in production logs a warning at boot.
HOST=127.0.0.1

# postgres://<user>:<password>@<host>:5432/<database>
# In production a REMOTE database host must carry an explicit TLS directive
# or env validation fails: append ?sslmode=require (or ?sslmode=verify-full
# for full cert verification, or ?ssl=true). A loopback / unix-socket DB is
# exempt.  prod remote example:
#   DATABASE_URL=postgres://volrep:pw@db.internal.example:5432/volrep?sslmode=require
DATABASE_URL=postgres://localhost:5432/volrep_dev

# Shared secret the Next.js frontend sends on every server-to-server call.
# PRODUCTION: must be a real random secret, >= 32 characters, and not a
# placeholder — generate with:  openssl rand -hex 32  (→ 64 hex chars).
# The volrep-maroc storefront must be configured with the SAME value as
# VOLREP_INTERNAL_API_KEY.
INTERNAL_API_KEY=replace-with-a-long-random-value

# HMAC secret for Product Studio draft-preview tokens. Dev: optional (falls
# back to INTERNAL_API_KEY). PRODUCTION: REQUIRED, >= 32 chars, no
# placeholder, and MUST be distinct from INTERNAL_API_KEY.
#   openssl rand -hex 32
# PRODUCT_PAGE_PREVIEW_SECRET=

ADMIN_SESSION_TTL_HOURS=12
CORS_ADMIN_ORIGIN=http://localhost:3001

# ---- Admin origin allow-list (security hardening — Step 2) -------------
# Used for BOTH CORS and the CSRF Origin/Referer check on state-changing
# /api/admin/* requests. Comma-separated absolute origins — no wildcard, no
# trailing path. When unset, falls back to [CORS_ADMIN_ORIGIN].
#   prod: ADMIN_TRUSTED_ORIGINS=https://admin.volrep.com
# ADMIN_TRUSTED_ORIGINS=

# HSTS max-age in seconds, sent only when NODE_ENV=production (2 years).
# Set 0 to disable. `preload` is never sent — only add it manually once
# EVERY subdomain of the registrable domain is guaranteed HTTPS-only.
# Deployment requirement: the reverse proxy (Nginx/Caddy) must redirect
# HTTP → HTTPS and terminate TLS.
HSTS_MAX_AGE=63072000

CART_EXPIRY_DAYS=30

# ---- Cart mutation rate limit (security hardening — Step 4 L3) ---------
# Per-route limit on POST/PATCH/DELETE /api/cart/lines (the GET is not
# limited). Keyed per cart id when the request carries one, else per
# trusted client IP. Generous by design — the storefront blocks a second
# cart mutation until the first resolves, so a human never reaches this.
CART_MUTATION_RATE_MAX=60
CART_MUTATION_RATE_TIME_WINDOW=1 minute

# ---- Product media storage (Phase 7C-2) --------------------------------
# "local" writes to MEDIA_LOCAL_DIR and serves it from this backend at
# /media/*. On the VPS switch to "s3" and fill the MEDIA_S3_* values — no
# application code changes (src/lib/media-storage is an adapter).
#
# PRODUCTION (local driver): the backend must NOT be publicly exposed, so
# /media/* is only reachable via the reverse proxy. Prefer letting Nginx
# serve MEDIA_LOCAL_DIR directly (an `alias` block) so image traffic never
# hits the Node event loop; object storage (s3 driver) is the path for
# horizontal scaling. See DEPLOYMENT.md §9.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=./var/media
MEDIA_PUBLIC_BASE_URL=http://localhost:4000
MEDIA_MAX_BYTES=10485760
# MP4 video (64 MiB) and animated GIF (16 MiB) caps — "Page produit" section
# media only; the product gallery stays images-only.
MEDIA_VIDEO_MAX_BYTES=67108864
MEDIA_GIF_MAX_BYTES=16777216

# ---- Media decompression-bomb guard (security hardening — Step 3) ------
# A raster image (JPEG/PNG/WebP/GIF) is rejected before storage when its
# HEADER declares dimensions past either bound — pixels are never decoded.
# Defaults leave generous room over any real product photo while stopping a
# tiny file that expands to gigapixels in the storefront's image optimizer.
MEDIA_IMAGE_MAX_PIXELS=40000000
MEDIA_IMAGE_MAX_DIMENSION=12000

# ---- Media upload rate limit (security hardening — Step 3) -------------
# Per-IP cap on the two authenticated admin upload endpoints, on top of the
# global 100/min. Generous — a full Studio session stays well under it.
MEDIA_UPLOAD_RATE_MAX=40
MEDIA_UPLOAD_RATE_TIME_WINDOW=5 minutes

# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=

# ---- Lirya landing-page integration (V1, READ-ONLY) -------------------
# Volrep binds a product to a Lirya landing page and caches a few display
# fields — it never stores Lirya HTML/content and never writes to Lirya
# (only the `pages:read` scope). Leave LIRYA_API_BASE_URL empty to disable
# the integration (the admin Landing Pages tab then shows a config hint).
# The API key is server-only: never NEXT_PUBLIC_, never sent to the browser.
#
# Configure per environment: point dev at a local Lirya, staging/prod at
# their own Lirya deployments, each with its own scoped `pages:read` key.
#   dev:     LIRYA_API_BASE_URL=http://localhost:xxxx
#   staging: LIRYA_API_BASE_URL=https://lirya.staging.example  (https required in prod)
#   prod:    LIRYA_API_BASE_URL=https://lirya.example
LIRYA_API_BASE_URL=
# When set (integration configured) PRODUCTION requires >= 32 chars and no
# placeholder value, same floor as INTERNAL_API_KEY.
LIRYA_API_KEY=
# Base URL of the legacy Lirya editor — only used to build an outbound
# "Modifier dans Lirya" navigation link. Never receives the API key.
LIRYA_ADMIN_BASE_URL=
LIRYA_TIMEOUT_MS=5000

LOG_LEVEL=info

# ---- Reverse proxy / client IP (security hardening — Step 1A) ---------
# Which peers may set X-Forwarded-* and thereby choose request.ip (used for
# rate limiting). Production topology is Internet → Nginx/Caddy (same host)
# → this backend, so the default trusts only loopback: a client that hits
# the backend directly cannot spoof its rate-limit identity. Accepts a
# single IP/CIDR, a comma-separated list, or a named range
# (loopback/linklocal/uniquelocal). Use "false" if nothing proxies the
# backend. "true" is rejected in production.
#   Nginx must forward the real client IP, e.g.:
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Real-IP $remote_addr;
TRUST_PROXY=loopback

# ---- Public COD order abuse guard (security hardening — Step 1C) ------
# Anti-flood limits for POST /api/checkout/session. Tuned for Moroccan COD:
# a real shopper places one or two orders, so these never touch legitimate
# traffic. All server-side price/stock/availability validation is unchanged.
#   per client IP (needs TRUST_PROXY set correctly + the storefront
#   forwarding X-Forwarded-For on COD calls):
COD_ORDER_IP_MAX=20
COD_ORDER_IP_TIME_WINDOW=10 minutes
#   per canonical phone number — short, self-clearing window (process-local):
COD_ORDER_PHONE_MAX=5
COD_ORDER_PHONE_WINDOW_MINUTES=30

# ---- Per-account admin-login throttle (security hardening — Step 4 M2) --
# Caps failed password guesses against ONE admin ACCOUNT (keyed by email)
# across all source IPs — the per-IP login limiter (10 / 15min, fixed in
# code) can't do that. Self-healing window: a TEMPORARY throttle, never a
# permanent lockout. Process-local; not shared across backend instances.
ADMIN_ACCOUNT_LOGIN_MAX_FAILURES=10
ADMIN_ACCOUNT_LOGIN_WINDOW_MINUTES=15

# Optional. Base URL of the storefront (volrep-maroc). When set, publishing a
# Product Studio "Page produit" pings {STOREFRONT_BASE_URL}/api/revalidate
# (auth: x-internal-api-key = INTERNAL_API_KEY) so the change goes live at
# once. Unset = the change appears on the storefront's next revalidation.
STOREFRONT_BASE_URL=http://localhost:3000
