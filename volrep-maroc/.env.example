# VOLREP storefront (volrep-maroc) — environment
#
# Every value here is SERVER-SIDE ONLY. None is NEXT_PUBLIC_* — the browser
# never receives the backend URL or the internal API key (lib/backend/client.ts
# is `server-only`).

# Base URL of the Volrep Fastify backend. Server-to-server only.
VOLREP_BACKEND_URL=http://localhost:4000

# Shared secret sent as `x-internal-api-key` on every backend call. Must match
# the backend's INTERNAL_API_KEY. Generate with: openssl rand -hex 32
VOLREP_INTERNAL_API_KEY=replace-with-a-long-random-value

# Origin that serves product media (backend /media/* in dev, an object-storage
# / CDN origin in prod). Used for next/image remotePatterns AND for the
# production Content-Security-Policy img-src (security hardening — Step 2).
# A real remote host must be https.
MEDIA_IMAGE_ORIGIN=http://localhost:4000

# NODE_ENV is set by Next (`development` for `next dev`, `production` for
# `next build` / `next start`). The strict CSP + HSTS headers are emitted
# only when it is `production`. Deployment requirement: the reverse proxy
# (Nginx/Caddy) terminates TLS and redirects HTTP → HTTPS.
