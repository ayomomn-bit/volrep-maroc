# Base URL of the Volrep Fastify backend. Safe to be public — it is just a
# URL, and the browser authenticates with the backend's httpOnly session
# cookie, never a secret. NO internal API key or DB credential belongs here.
# In production this origin is also injected into the CSP `connect-src` /
# `img-src` (security hardening — Step 2), so it must be the exact origin the
# browser calls, e.g. https://api.volrep.com
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000

# The backend's CSRF/CORS allow-list (ADMIN_TRUSTED_ORIGINS there) must list
# this admin app's own origin, e.g. https://admin.volrep.com
#
# Production headers (strict CSP, HSTS, frame-ancestors 'none') are emitted
# only when NODE_ENV=production. Reverse proxy must terminate TLS + redirect
# HTTP → HTTPS.

# Base URL of the separate COD operations system. Volrep Admin does NOT
# manage COD operations (order confirmation, calling, delivery, fulfilment)
# — the order screens link out to this system instead. Leave empty until it
# exists; the CTA then renders as a disabled state. Also public, not a secret.
NEXT_PUBLIC_COD_SYSTEM_URL=

# Public base URL of the Volrep storefront (volrep-maroc). Used only to build
# the Product Studio "Page produit" → Aperçu link. Defaults to the local dev
# storefront when unset. Also public, not a secret.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
